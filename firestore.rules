rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isManager() {
      return request.auth != null
        && request.auth.token.get('role', '') in ['admin', 'coordinator'];
    }

    function isStaff() {
      return request.auth != null
        && request.auth.token.get('role', '') == 'staff';
    }

    // Halaman publik: hanya satu dokumen aktif, harus tahu token
    match /publicTracking/{token} {
      allow get: if resource != null && resource.data.active == true;
      allow list, write: if false;
    }

    // Antrean: dibaca manajer dan petugas; tidak pernah ditulis dari browser
    match /queues/{queueId} {
      allow read: if isManager() || isStaff();
      allow write: if false;
    }

    // Peserta: hanya manajer
    match /participants/{participantId} {
      allow read: if isManager();
      allow write: if false;
    }

      match /{document=**} {
      allow read, write: if false;
    }
  }
}